# Copy to .env on the VPS.  Any NEPSE_* var overrides config/settings.toml.

# --- scraper behaviour (optional overrides) ---------------------------
# NEPSE_HEADLESS=false
# NEPSE_CHANNEL=chrome
# NEPSE_LEVEL=INFO
# NEPSE_LIST=NEPSE,NABIL,ADBL

# --- how the data leaves the VPS -------------------------------------
# one of: tailscale-rsync | git | rclone | none
SYNC_STRATEGY=none

# tailscale-rsync:  rsync target on your local machine (over the tailnet)
#   SYNC_DEST=you@your-laptop:/home/you/nepse-data/data/
# rclone:  a configured remote + path
#   SYNC_DEST=mydrive:nepse-data
SYNC_DEST=
