[Unit]
Description=Run the NEPSE daily scrape after market close

[Timer]
# NEPSE moved to a Mon-Fri trading week in April 2026 (Sat/Sun weekend).
# Trading hours 11:00-15:00 NPT (UTC+05:45); nepsealpha's daily row is
# usually settled by ~17:00 NPT.  17:45 NPT == 12:00 UTC.
# systemd OnCalendar uses the machine's own timezone; set the box to UTC
# (recommended) or adjust the clock time below to match your box's TZ.
OnCalendar=Mon,Tue,Wed,Thu,Fri *-*-* 12:00:00 UTC
# if the box was off at 12:00, run as soon as it's back
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
